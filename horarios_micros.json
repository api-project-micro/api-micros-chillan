import json
from datetime import datetime
from playwright.sync_api import sync_playwright

def extraer_horarios_cuadrante_4():
    # Datos de configuración del Cuadrante 4
    NOMBRE_CUADRANTE = "Cuadrante 4: Suroriente"
    URL_CUADRANTE = "https://www.google.com/maps/search/Parada+de+autob%C3%BAs+cerca+de+-36.6300,+-72.0750"

    with sync_playwright() as p:
        browser = p.chromium.launch(
            headless=True,
            args=[
                "--disable-blink-features=AutomationControlled",
                "--no-sandbox",
                "--disable-setuid-sandbox",
                "--disable-dev-shm-usage"
            ]
        )
        
        context = browser.new_context(
            user_agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
            locale="es-CL",
            viewport={"width": 1280, "height": 720}
        )
        page = context.new_page()
        
        print(f"==================================================")
        print(f" EJECUTANDO SCRAPER: {NOMBRE_CUADRANTE}")
        print(f" Coordenadas filtro: -36.6300, -72.0750")
        print(f"==================================================")
        
        horarios_extraidos = []
        
        try:
            page.goto(URL_CUADRANTE, wait_until="domcontentloaded", timeout=40000)
            page.wait_for_timeout(6000)
            
            print("Guardando screenshot: paso_1_cuadrante_4_inicio.png...")
            page.screenshot(path="paso_1_cuadrante_4_inicio.png")
            
            # Buscar el primer resultado de parada desplegado en el feed del cuadrante 4
            primera_parada = page.locator("div[role='feed'] a[aria-label], div.a4E33c").first
            if primera_parada.is_visible(timeout=5000):
                print("Haciendo clic en la parada seleccionada del Cuadrante 4...")
                primera_parada.click()
                page.wait_for_timeout(4000)

            # Intentar desplegar el panel de salidas en tiempo real
            btn_salidas = page.locator("button:has-text('Ver el panel de salidas'), div[role='button']:has-text('Ver el panel de salidas')").first
            if btn_salidas.is_visible(timeout=5000):
                btn_salidas.click()
                print("¡Clic exitoso en 'Ver el panel de salidas'!")
                page.wait_for_timeout(8000)

            print("Guardando screenshot: paso_2_cuadrante_4_panel.png...")
            page.screenshot(path="paso_2_cuadrante_4_panel.png")

            # Extraer los contenedores de micros
            filas = page.locator("div.iP2t7d, div.n5vinf, div.Fkgn4d, div[jsaction]").all()
            print(f"=== FILAS DETECTADAS EN EL PANEL ({len(filas)}) ===")

            for idx, fila in enumerate(filas):
                try:
                    texto_fila = fila.inner_text().strip()
                    if not texto_fila:
                        continue
                    
                    lineas = [l.strip() for l in texto_fila.split("\n") if l.strip()]
                    
                    # Identificar patrón de hora
                    hora_encontrada = None
                    for l in lineas:
                        if ":" in l and ("a.m." in l.lower() or "p.m." in l.lower()):
                            hora_encontrada = l
                            break
                    
                    if not hora_encontrada:
                        continue
                        
                    # Extraer el número de la micro
                    numero_micro = ""
                    try:
                        badge = fila.locator("span.SJ4nDcl, span[class*='SJ4nD']").first
                        if badge.is_visible(timeout=500):
                            numero_micro = badge.inner_text().strip()
                    except:
                        pass
                    
                    if not numero_micro and len(lineas) > 0:
                        posible = lineas[0]
                        if len(posible) <= 4 and posible.isalnum():
                            numero_micro = posible
                    
                    # Limpiar texto para obtener el destino
                    textos_limpios = [
                        l for l in lineas 
                        if l != hora_encontrada and l != numero_micro and not any(r in l.lower() for r in ["restaurantes", "hoteles", "farmacias", "cajeros", "google"])
                    ]
                    
                    destino = " ".join(textos_limpios) if textos_limpios else "Suroriente"
                    
                    # Armar detalle final
                    if numero_micro and not destino.startswith(numero_micro):
                        detalle_final = f"{numero_micro} - {destino}"
                    else:
                        detalle_final = destino
                        
                    if len(detalle_final) > 2:
                        item = {
                            "detalle": detalle_final,
                            "hora": hora_encontrada,
                            "empresa": "Transporte Público Chillán",
                            "precio": "$500"
                        }
                        if item not in horarios_extraidos:
                            horarios_extraidos.append(item)
                            print(f" -> Encontrado: {detalle_final} ({hora_encontrada})")
                            
                except Exception as ex:
                    continue

        except Exception as e:
            print(f"Error durante la extracción en {NOMBRE_CUADRANTE}: {e}")
            
        browser.close()
        
        fecha_actual = datetime.now().strftime("%Y-%m-%d %H:%M hrs")
        resultado = {
            "ciudad": "Chillán",
            "cuadrante": "4",
            "sector": "Suroriente (Los Volcanes / Mapuches / Alonso de Ercilla)",
            "actualizado_en": fecha_actual,
            "rutas": horarios_extraidos
        }
        
        with open("horarios_cuadrante_4.json", "w", encoding="utf-8") as f:
            json.dump(resultado, f, ensure_ascii=False, indent=4)

        print(f"\n✅ Extracción completada para {NOMBRE_CUADRANTE}.")
        print(f"📄 Se guardaron {len(horarios_extraidos)} registros en 'horarios_cuadrante_4.json'.")

if __name__ == "__main__":
    extraer_horarios_cuadrante_4()
